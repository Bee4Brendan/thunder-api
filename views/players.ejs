<%- include("partials/header.ejs") %>
    <body id="players-body">
        <div class="row-container">
            <!-- Show Selected Player Info or Instruct User to Select One -->
            <% if (selectedPlayer) { %>
                <%- include("partials/player-info.ejs") %>
            <% } else { %>
                <section class="flex center player-info empty">
                    <h1 class="blue">Select A Player</h1>
                </section>
            <% } %>
            <!-- The List of Players (Thunder Roster) -->
            <%- include("partials/player-list.ejs") %>
        </div>
        <script src="/scripts/players.js"></script>
    </body>
</main>
</html>
