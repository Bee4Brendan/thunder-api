<ul class="schedule-list">
    <% thunderSchedule.forEach(game => { %>
        <li 
            class="schedule-item liquid-glass
                <%= game.hasBeenPlayed ? 'past-game' : '' %> 
                <%= game.isThunderHomeGame ? 'home-game' : 'away-game' %>
                <%= game.isNextGame ? 'next-game' : '' %>
                <%= game.isStarred ? 'starred-game' : '' %> 
                <%= game.result === "W" ? 'win' : 'loss'%>"
            data-home="<%= game.isThunderHomeGame %>"
            data-away="<%= !game.isThunderHomeGame %>"
            data-next="<%= game.isNextGame %>"
            data-cup="<%= game.isCupGame %>"
            data-starred="<%= game.isStarred %>"
            data-win="<%= game.result === "W"%>"
            data-home-team="<%= game.home_team.name %>"
            data-visitor-team="<%= game.visitor_team.name %>"
            data-date="<%= game.prettyDate %>"
        >
            <div class="flex-column full-width">

                <div class="game-info">
                    <div class="game-date">
                        <p><%= game.prettyDate ? game.prettyDate : "" %></p>
                        <span><%= game.time ? game.time + " CT" : "" %></span>
                    </div>
                </div>

                <div class="schedule-item upper-section">
                    <!-- <div class="game-number kanit-font">
                        <%= game.gameNumber %>
                        
                    </div> -->


                    <img id="home-team-logo" src="/images/team-logos/<%= game.home_team.name %>.svg" />
                    <p id="home-team-score" class="score <%= game.home_team_score > game.visitor_team_score ? 'bold' : '' %>"><%= game.home_team_score %></p>
                    <p id="visitor-team-score" class="score <%= game.visitor_team_score > game.home_team_score ? 'bold' : '' %>"><%= game.visitor_team_score %></p>
                    <img id="visitor-team-logo" src="/images/team-logos/<%= game.visitor_team.name %>.svg" />
                    
                    <p id="home-team-name"><%= game.home_team.name %></p>
                    <p id="visitor-team-name"><%= game.visitor_team.name %></p>
                    <p id="status"><%= game.status && !game.status.endsWith('Z') ? game.status + " • " : '' %> <%= game.wins %> - <%= game.losses %></p>
                    <% if (game.isCupGame) { %>
                        <img id="cup-trophy-image" src="/images/cup-trophy.png">
                    <% } %>
                    <p id="result" class="<%= game.result === 'W' ? 'win' : 'loss' %>"><%= game.result %></p>
                </div>
                <div class="lower">
                    <div class="bottom-section">
                    <% game.channels.forEach(channel => { %>
                        <img class="tv-logo" src="/images/tv-logos/<%= channel %>.svg" alt="<%= channel %>">
                    <% }) %>
                    </div>
                </div>  
            </div>
        </li>
    <% }); %>
</ul>